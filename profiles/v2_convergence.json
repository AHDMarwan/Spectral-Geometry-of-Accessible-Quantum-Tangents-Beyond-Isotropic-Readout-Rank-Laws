  "spectral": {"enabled": false},
  "random_readout_null": {"draws": 0},
  "numerical_tolerances": {
    "state_norm_error": 5e-12,
    "horizontal_overlap_max": 5e-10,
    "probability_sum_error": 5e-12,
    "probability_tangent_sum_max": 1e-9,
    "fisher_violation_max": 1e-9,
    "projector_bound_slack": 2e-9
  }
